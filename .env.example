# Copie para .env e ajuste os valores (NUNCA suba o .env para o GitHub)
POSTGRES_USER=medgraph
POSTGRES_PASSWORD=troque_esta_senha
POSTGRES_DB=medgraph

NEO4J_USER=neo4j
NEO4J_PASSWORD=troque_esta_senha_tambem

# Usado no passo 4 (autenticação JWT). Gere com: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=troque_por_uma_chave_longa_e_aleatoria
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Passo 11: endereços das telas autorizados a chamar a API (separe por vírgula)
# CORS_ORIGINS=http://localhost:5500,https://medgraph-am.netlify.app

# Passo 12: limites de upload (MB). Os arquivos ficam no volume 'uploads' do Docker.
# MAX_AUDIO_MB=15
# MAX_FOTO_MB=8

# Passo 13: "desenvolvimento" (padrão) só avisa sobre senha/chave fraca; "producao" RECUSA subir com elas.
# Para a demonstração à banca use o docker-compose.prod.yml (ele já define AMBIENTE=producao).
# AMBIENTE=desenvolvimento

# Assistente de IA (Gemini / Google AI Studio). Deixe a chave vazia para desligar.
GEMINI_API_KEY=
GEMINI_ATIVO=1
GEMINI_MODELO=gemini-flash-lite-latest
GEMINI_LIMITE_HORA=60
