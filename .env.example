# Copie para .env e ajuste os valores (NUNCA suba o .env para o GitHub)
POSTGRES_USER=medgraph
POSTGRES_PASSWORD=troque_esta_senha
POSTGRES_DB=medgraph

NEO4J_USER=neo4j
NEO4J_PASSWORD=troque_esta_senha_tambem

# Usado na autenticação JWT. Gere com: openssl rand -hex 32
SECRET_KEY=troque_por_uma_chave_longa_e_aleatoria
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Endereços das telas que podem chamar a API pelo navegador (separados por vírgula, sem barra no final).
# Opcional: se omitir, valem as portas de desenvolvimento 5500, 3000, 5173 e 8080 em localhost.
# CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
